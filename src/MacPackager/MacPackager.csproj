<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>bamm-macos-publisher</AssemblyName>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<!-- Default Runtime Identifier: Windows x64 (64 Bit) -->
		<RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;linux-arm</RuntimeIdentifiers>
		<Authors>Static-Codes</Authors>
		<Copyright>Copyright © Static</Copyright>
		<PackageTags>console;utility;windows;linux;osx</PackageTags>
		<Description>A utility written to package BAMM from a standalone binary to a macOS .pkg</Description>
	</PropertyGroup>

	<PropertyGroup>
		<!-- NuGet Package Metadata -->
		<PackAsTool>false</PackAsTool>
		<PackageId>bamm-macos-publisher</PackageId>
		<PackageVersion>1.0.0-alpha5</PackageVersion>
		<!-- Windows & OSX License -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<ApplicationIcon>bamm.ico</ApplicationIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	
	<!-- Debian Packaging Properties -->
	<PropertyGroup>
		<CommonPackageName>$(PackageId)</CommonPackageName>
		<CommonPackageVersion>$(PackageVersion)</CommonPackageVersion>
		<CommonPackageSummary>Custom scripting language for Web Automation that compiles for Python</CommonPackageSummary>
		<CommonPackageLicense>MIT</CommonPackageLicense>
		<CommonDesktopName>BAMM for macOS Publisher</CommonDesktopName>
		<RepositoryUrl>https://github.com/Static-Codes/BrowserAutomationMaster/</RepositoryUrl>
	</PropertyGroup>

	<!-- Debian Package Metadata-->
	<PropertyGroup Condition="'$(BuildDebPackage)' == 'true'">
		<DebianPackageMaintainer>$(Authors)</DebianPackageMaintainer>
		<DebianPackageDescription>$(Description)</DebianPackageDescription>
		<DebianPackageSection>utils</DebianPackageSection>
		<DebianPackagePriority>optional</DebianPackagePriority>
		<DebianPackageRequires>libicu-dev, python3</DebianPackageRequires>
		<DebianDesktopFile>$(CommonPackageName).desktop</DebianDesktopFile>
		<DebianDesktopCategories>Utility;Console;</DebianDesktopCategories>
		<DebianDesktopTerminal>true</DebianDesktopTerminal>
		<DebianDesktopName>$(CommonDesktopName)</DebianDesktopName>
	</PropertyGroup>


	<!-- Fedora Package Metadata-->
	<PropertyGroup Condition="'$(BuildRpmPackage)' == 'true'">
		<RpmPackageName>$(CommonPackageName)</RpmPackageName>
		<RpmVersion>$(CommonPackageVersion)</RpmVersion>
		<RpmRelease>1</RpmRelease>
		<RpmSummary>$(CommonPackageSummary)</RpmSummary>
		<RpmLicense>$(CommonPackageLicense)</RpmLicense>
		<RpmUrl>$(RepositoryUrl)</RpmUrl>
		<RpmVendor>$(Authors)</RpmVendor>
		<RpmPackager>$(Authors)</RpmPackager>
		<RpmGroup>Applications/Utilities</RpmGroup>
		<RpmRequires>$(RpmRequires) libicu, python3</RpmRequires>
		<RpmDesktopFile>$(CommonPackageName).desktop</RpmDesktopFile>
		<RpmDesktopCategories>Utility;Console;Development;</RpmDesktopCategories>
		<RpmDesktopTerminal>true</RpmDesktopTerminal>
		<RpmDesktopName>$(CommonDesktopName)</RpmDesktopName>
	</PropertyGroup>



	<ItemGroup>
	  <Content Include="bamm.ico" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Packaging.Targets" Version="0.1.232">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Spectre.Console" Version="0.50.0" />
  </ItemGroup>

</Project>
