<Project>
	<!-- GUI.zip Download and Embed Logic -->
	<!--
		The version served on /gui_version is read back out of this archive at runtime, so it always
		matches the GUI that was actually embedded.
	-->
	<PropertyGroup>
		<ResourceURL>https://github.com/Static-Codes/BAMM-GUI/releases/latest/download/gui.zip</ResourceURL>
    	<DownloadDir>Resources</DownloadDir>
    	<DownloadedFileName>gui.zip</DownloadedFileName>
		<!-- MSBuild on Windows handles forward slashes as intended, but, Unix treats backslashes as literals rather than seperators -->
    	<_FullGUIResourcePath>$(DownloadDir)/$(DownloadedFileName)</_FullGUIResourcePath>
	</PropertyGroup>

    <!-- Download and Embed Logic-->
	<Target Name="RetrieveAndEmbedResources" BeforeTargets="PrepareForBuild">

		<!-- Erroring out if an unsupported Windows Build is found.-->
		<Error Condition="'$(IsSupportedWin10)' == 'false'" Text="Build Failure: Unsupported Windows 10 build version detected: $(WindowsBuildVersion)" />

		<Error Condition="'$(ResourceURL)' == ''" Text="Build Failure: ResourceURL property is empty." />

		<!-- Creating the DownloadDir, if it was removed for some reason. -->
		<MakeDir Directories="$(DownloadDir)" />

		<!-- Deleting a previously downloaded copy of the file if its present, to ensure it's the latest version. -->
		<Delete Files="$(_FullGUIResourcePath)" Condition="Exists('$(_FullGUIResourcePath)')" />

		<!-- Downloading the file located at the specified url, to the provided output path. -->
		<!-- Handle exit code 6, which means no network connection is present. -->
		<Exec Command="curl -fLs &quot;$(ResourceURL)&quot; -o &quot;$(_FullGUIResourcePath)&quot;" StandardOutputImportance="low" IgnoreExitCode="true">
			
			<Output TaskParameter="ExitCode" PropertyName="CurlExitCode" />
		</Exec>
		
		<Error Condition="'$(CurlExitCode)' == '6'" Text="Please ensure you have an active network connection; curl could not resolve the host for $(ResourceURL)." />

		<Error Condition="'$(CurlExitCode)' != '0' AND '$(CurlExitCode)' != '6'" Text="Resource download failed with exit code: $(CurlExitCode)." />
        
        <!-- This was moved to the main csproj to prevent duplicate attempts at embedding the gui archive. -->
        <!-- 
		<ItemGroup>
			<EmbeddedResource Include="$(_FullGUIResourcePath)" Watch="false" />
		</ItemGroup> -->
	</Target>

	<!-- Windows Version Check -->
	<!-- Due to BAMM support all versions of Windows 10 and 11 this check is required-->
	<!-- This check is  prior to April 2018 (build 10240) will fail as they do not support curl natively -->
	<Target Name="ValidateWindowsVersion" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PropertyGroup>
      		<IsSupportedWin10>$([MSBuild]::VersionGreaterThanOrEquals($(WindowsBuildVersion), 10240))</IsSupportedWin10>
    	</PropertyGroup>
	</Target>

	<Target Name="RemoveGUIAfterEmbed" AfterTargets="Build">
      	<Delete Files="$(_FullGUIResourcePath)" Condition="Exists('$(_FullGUIResourcePath)')" />
	</Target>
</Project>