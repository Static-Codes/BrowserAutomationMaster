<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BrowserAutomationMaster.Tests</RootNamespace>
    <AssemblyName>BrowserAutomationMaster.Tests</AssemblyName>

    <!--
      NAOT (Native AOT) compliance is intentionally NOT required for this project.
      See: https://github.com/Static-Codes/BrowserAutomationMaster/issues/10
      "Since NAOT isn't used in BAMM, the XUnit tests aren't required to be NAOT compliant."
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <!--
      The bare package, not Microsoft.Playwright.XUnit. The .XUnit package brings its own test host
      and assembly-level collection behaviour, which fights this repo's xunit.runner.json
      (parallelizeTestCollections: false) and its ConsoleCapture global-console pattern.
      The browser is driven from a hand-written IAsyncLifetime collection fixture instead.
    -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GuiServerHost lives inside this project's folder, so the SDK's default globs pick up its
      generated obj/ sources alongside this project's own and every AssemblyInfo attribute is declared
      twice (CS0579). It is a separate project, not part of this one's compilation.
    -->
    <Compile Remove="Gui/Server/GuiServerHost/**/*.cs" />
    <EmbeddedResource Remove="Gui/Server/GuiServerHost/**" />
    <None Remove="Gui/Server/GuiServerHost/**" />
  </ItemGroup>

  <Import Project="Gui/BammGui.props" />

  <ItemGroup>
    <ProjectReference Include="../BrowserAutomationMaster\BrowserAutomationMaster.csproj" />
    <!--
      GuiServerHost is a helper, not a test project: it is the small console app that holds the GUI's
      HttpListener open while Tier B talks to it. Referenced here so it builds and lands in this
      project's output directory, the same way bamm.dll does, and GuiServerProcess finds it through
      AppContext.BaseDirectory.
    -->
    <ProjectReference Include="Gui/Server/GuiServerHost/GuiServerHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      BAMM's validation routines write to the process-global Console, so test collections running
      in parallel interleave their output character by character and render the results unreadable.
      Collections are therefore run sequentially. The suite is fast enough that this costs little.
    -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Fallback script discovery for the ScriptExecution suite. The filenames under
      examples/Chrome and examples/Firefox are unique, so flattening them into a
      single userScripts directory is safe.
    -->
    <None Include="../../examples/**/*.bamc" Link="userScripts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>